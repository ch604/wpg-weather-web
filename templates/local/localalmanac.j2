<div class="slider-item local-averages">
	<!--local hi/lo averages-->
	{% include 'local/localheader.j2' %}
	<p style="text-align:center;">LOCAL AVERAGES FOR {{ weather_data.forecast_date }}</p>
</div>
<div class="slider-item local-almanac">
	<!--local sunrise/sunset, moon phase forecast-->
	{% include 'local/localheader.j2' %}
	<p style="text-align:center;">ASTROLOGY FOR {{ weather_data.forecast_date }}</p>
	<p>SUNRISE: {{ almanac_data.sunrise }}</p>
	<p>SUNSET: {{ almanac_data.sunset }}</p>
	<br>
	<p>MOONRISE: {{ almanac_data.moonrise }}</p>
	<p>MOONSET: {{ almanac_data.moonset }}</p>
	<p>MOONPHASE: {{ almanac_data.phase }}</p>
</div>
